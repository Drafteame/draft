func ProvideResources(ctx context.Context, opts ...providers.Option) (any, error) {
	ctx, span := oteltracer.StartSpan(ctx, oteltracer.HandlerSpanName("{{ .ServiceName }}", "provide-resources"),
		oteltracer.WithAttributes(
			oteltracer.Domain("{{ .ServiceName }}"),
			oteltracer.Layer(oteltracer.LayerHandler),
		),
	)
	defer span.End()

{{- if .UseIdempotency }}
	idemService, err := prvidempotency.ProvideTurbo(opts...) // TODO: change to correct idempotency provider
	if err != nil {
		oteltracer.SetError(ctx, err)
		return nil, err
	}

{{- end }}
	// TODO: Implement your resources logic here

	return &Resources{
{{- if .UseIdempotency }}
		IdemService: idemService,
{{- end }}
		// TODO: resources
	}, nil
}
