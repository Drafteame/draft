{{- if .UseIdempotency }}
func Worker(r *Resources) func(ctx context.Context, input json.RawMessage) (result any, err error) {
	return func(ctx context.Context, input json.RawMessage) (result any, err error) {
		newCtx, span := oteltracer.StartSpan(ctx, oteltracer.HandlerSpanName("{{ .ServiceName }}", "worker"),
			oteltracer.WithAttributes(
				oteltracer.Domain("{{ .ServiceName }}"),
				oteltracer.Layer(oteltracer.LayerHandler),
			),
		)
		defer span.End()

		// Defer cleanup: remove idempotency key on retryable errors to allow retry
		defer func() {
			if err != nil && isRetryableError(err) {
				_ = r.deleteIdempotency(newCtx, input)
			}
		}()

		// Set idempotency key to prevent duplicate processing
		if err = r.SetIdempotency(newCtx, input); err != nil {
			oteltracer.SetError(newCtx, err)
			return nil, err
		}

		// TODO: implement worker logic here
		// You can unmarshal the input into your custom type:
		// var myInput MyInputType
		// if err := json.Unmarshal(input, &myInput); err != nil {
		//     return nil, err
		// }

		return nil, nil
	}
}
