func Worker(r *Resources) base.Worker[types.Event[dtos.Event]] {
	return func(ctx context.Context, event types.Event[dtos.Event]) error {
		newCtx, span := oteltracer.StartSpan(ctx, oteltracer.HandlerSpanName("{{ .ServiceName }}", "worker"),
			oteltracer.WithAttributes(
				oteltracer.Domain("{{ .ServiceName }}"),
				oteltracer.Layer(oteltracer.LayerHandler),
			),
		)
		defer span.End()

		// TODO: Implement your worker logic here

		log.Get().DebugContext(newCtx, "finish {{ .LambdaName }} worker")

		return nil
	}
}
