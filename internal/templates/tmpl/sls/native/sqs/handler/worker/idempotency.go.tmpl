package worker

import (
	"context"
	"fmt"

	"{{ .PackageName }}/pkg/log"
	oteltracer "{{ .PackageName }}/pkg/otel/tracer"
	"{{ .PackageName }}/{{ .ServicePath }}/{{ if not .IsLegacy }}cmd/{{ end }}sqs/{{ .LambdaName }}/handler/dtos"
)

func (r *Resources) GenerateIdempotencyKey(ctx context.Context, event dtos.Event, action string) string {
	eventRootID, ok := ctx.Value(base.CtxKeyRootID).(string)
	if !ok {
	    log.Get().ErrorContext(newCtx, "error obtaining root ID for idempotency key generation", slog.String("action", action))
	}

	return fmt.Sprintf("%s:%s", action, eventRootID)
}

func (r *Resources) SetIdempotency(ctx context.Context, evt dtos.Event) (err error) {
	newCtx, span := oteltracer.StartSpan(ctx, oteltracer.HandlerSpanName("{{ .ServiceName }}", "set-idempotency"),
		oteltracer.WithAttributes(
			oteltracer.Domain("{{ .ServiceName }}"),
			oteltracer.Layer(oteltracer.LayerHandler),
		),
	)
	defer span.End()

	defer func() {
		if r := recover(); r != nil {
			err = fmt.Errorf("%v", r)
			logger.Get().Err(err).Error("panic recovered in {{ .LambdaName }} handler")
		}
	}()

	idemKey := r.GenerateIdempotencyKey(newCtx, evt, Action)

	return r.IdemService.Set(newCtx, idemKey)
}

func (r *Resources) DelIdempotency(ctx context.Context, key string) error {
	newCtx, span := oteltracer.StartSpan(ctx, oteltracer.HandlerSpanName("{{ .ServiceName }}", "del-idempotency"),
		oteltracer.WithAttributes(
			oteltracer.Domain("{{ .ServiceName }}"),
			oteltracer.Layer(oteltracer.LayerHandler),
		),
	)
	defer span.End()

	if err := r.IdemService.Delete(newCtx, key); err != nil {
		oteltracer.SetError(newCtx, err)
		logger.Get().Err(err).Fields(map[string]any{"key": key}).Error("error deleting idempotency key")
		return err
	}

	return nil
}

func (r *Resources) deleteIdempotency(ctx context.Context, evt dtos.Event) error {
	newCtx, span := oteltracer.StartSpan(ctx, oteltracer.HandlerSpanName("{{ .ServiceName }}", "delete-idempotency"),
		oteltracer.WithAttributes(
			oteltracer.Domain("{{ .ServiceName }}"),
			oteltracer.Layer(oteltracer.LayerHandler),
		),
	)
	defer span.End()

	key := r.GenerateIdempotencyKey(newCtx, evt, Action)

	if err := r.DelIdempotency(newCtx, key); err != nil {
		oteltracer.SetError(newCtx, err)
		logger.Get().Err(err).Fields(map[string]any{"key": key}).Error("error deleting idempotency key")
		return err
	}

	return nil
}
