package handler

import (
	ehttp "{{ .PackageName }}/projects/framev2/engine/http"
	"{{ .PackageName }}/projects/framev2/engine/http/middlewares"{{ if .UseDig }}
	"{{ .PackageName }}/projects/framev2/pkg/inject"
	"{{ .PackageName }}/projects/framev2/pkg/logger"{{ end }}
)

{{ if .UseDig }}func init() {
	if err := inject.Get().Provide(New); err != nil {
		logger.Get().Err(err).Fatal("error providing handler")
	}
}{{ end }}

type Handler struct {
	router ehttp.Router
}

func New(router ehttp.Router) {{ if not .UseDig }}ehttp.{{ end }}Handler {
	return Handler{
		router: router,
	}
}

func (h Handler) Register() {
	h.router.{{ .HTTPMethod }}(
		path,
		h.handle,
		middlewares.AuthAPIKey(),
	)
}
