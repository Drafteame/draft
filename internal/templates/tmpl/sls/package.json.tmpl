{
  "name": "{{ .NormalizedServiceName }}",
  "devDependencies": {
    "serverless": "^3.38.0",
    "serverless-hooks": "^1.0.0",
    "serverless-plugin-datadog": "^5.103.0",
    "serverless-plugin-go": "^0.1.0",
    "serverless-plugin-lambda-insights": "^2.0.0",
    "serverless-plugin-s3-remover": "^0.1.6",
    "serverless-plugin-pkl": "^0.2.1",
    "serverless-prune-plugin": "^2.1.0",
    "serverless-plugin-warmup": "^8.3.0",
    "serverless-domain-manager": "^8.0.0",
    "serverless-plugin-stage-reserved-concurrency": "^0.5.0"
  },
  "scripts": { {{ if .CustomDomain }}
    "hook:before:deploy:deploy": "./node_modules/.bin/sls create_domain --stage $STAGE --verbose $SLS_PARAMS", {{ end }}
    "deploy": "./node_modules/.bin/sls deploy --stage $STAGE --verbose $SLS_PARAMS",
    "print:dev": "env STAGE=dev ./node_modules/.bin/sls print --stage dev --verbose --aws-profile draftea-dev $SLS_PARAMS",
    "deploy:function": "./node_modules/.bin/sls deploy function -f $FUNCTION_NAME --stage $STAGE --update-config --verbose $SLS_PARAMS"
  }
}