receivers:
  otlp:
    protocols:
      http:
        endpoint: localhost:4319

exporters:
  otlphttp/datadog:
    traces_endpoint: "https://otlp.${env:DD_SITE}/v1/traces"
    metrics_endpoint: "https://otlp.${env:DD_SITE}/v1/metrics"
    headers:
      DD-API-KEY: "${env:DD_API_KEY}"
      DD-OTEL-METRIC-CONFIG: '{"resource_attributes_as_tags": true}'

service:
  pipelines:
    traces:
      receivers: [otlp]
      exporters: [otlphttp/datadog]
    metrics:
      receivers: [otlp]
      exporters: [otlphttp/datadog]
