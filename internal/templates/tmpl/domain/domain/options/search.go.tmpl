// Orders
// -------------------------------------------------------------------

func (so SearchOptions) OrderByCreatedAt(order string) SearchOptions {
	so.Orders = so.Orders.SetCreatedAt(order)
	return so
}

// Pagination
// -------------------------------------------------------------------

func (so SearchOptions) Limit(limit int64) SearchOptions {
	so.Pagination = so.Pagination.SetLimit(limit)
	return so
}

func (so SearchOptions) Offset(offset int64) SearchOptions {
	so.Pagination = so.Pagination.SetOffset(offset)
	return so
}
