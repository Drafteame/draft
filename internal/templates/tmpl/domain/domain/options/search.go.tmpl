package options

type SearchOptions struct {
	Filters    SearchFilters
	Orders     SearchOrders
	Pagination SearchPagination
}

func NewSearchOptions() SearchOptions {
	return SearchOptions{
		Pagination: SearchPagination{Limit: DefaultPaginationLimit},
	}
}

func (so SearchOptions) SetFilters(filters SearchFilters) SearchOptions {
	so.Filters = filters
	return so
}

func (so SearchOptions) SetOrders(orders SearchOrders) SearchOptions {
	so.Orders = orders
	return so
}

func (so SearchOptions) SetPagination(pagination SearchPagination) SearchOptions {
	so.Pagination = pagination
	return so
}

