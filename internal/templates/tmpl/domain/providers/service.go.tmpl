package providers

import (
  "context"
  "os"
  "sync"
  "fmt"

  "{{.PackageName}}/{{ .DomainPath }}/domain"
  dmnoptions "{{.PackageName}}/{{ .DomainPath }}/domain/options"
	"{{.PackageName}}/{{ .DomainPath }}/service"
	"{{.PackageName}}/pkg/providers"
	"{{.PackageName}}/projects/framev2/pkg/logger"
)

// Service is an abstration of the Service struct that allow to use a mock struct and the real struct at the same time
// depending if the STAGE env indicates a test environment or not
type Service interface {
	Create(ctx context.Context, m domain.{{.DomainNamePascal}}) (domain.{{.DomainNamePascal}}, error)
	Delete(ctx context.Context, id string) (domain.{{.DomainNamePascal}}, error)
	Get(ctx context.Context, id string) (domain.{{.DomainNamePascal}}, error)
	Search(ctx context.Context, so dmnoptions.SearchOptions) ([]domain.{{.DomainNamePascal}}, int64, error)
	SearchOne(ctx context.Context, filters dmnoptions.SearchFilters) (domain.{{.DomainNamePascal}}, error)
	Update(ctx context.Context, id string, fields dmnoptions.UpdateFields) (domain.{{.DomainNamePascal}}, error)
}

const PrvService = "domains.{{ .DomainNameLower }}.service"

var serviceInstance Service

// ProvideService returns a Service instance based on the environment.
// If the STAGE environment variable is not set, it provides a test service.
func ProvideService(opts ...providers.Option) (Service, error) {
  if os.Getenv("STAGE") == "" {
	return provideTestService(opts...)
  }

  var initErr error

  sync.OnceFunc(func() {
	srv, err := createServiceInstance(opts...)
	if err != nil {
	  initErr = err
	  logger.Get().Err(err).Fields(map[string]any{"name": PrvService}).
		Error("error creating service instance")
	}

	serviceInstance = srv
  })

  if initErr != nil {
	return nil, initErr
  }

  return serviceInstance, nil
}

// provideTestService returns a test Service instance.
func provideTestService(opts ...providers.Option) (Service, error) {
  options, err := providers.BuildOptions(opts...)
  if err != nil {
	return nil, err
  }

  if options.Container.Exists(PrvService) {
	svc, ok := options.Container.Get(PrvService).(Service)
	if !ok {
	  return nil, fmt.Errorf("saved object in '%s' doesn't implement provider Service interface", PrvService)
	}
	return svc, nil
  }

  srv, err := createServiceInstance(opts...)
  if err != nil {
	return nil, err
  }

  options.Container.Set(PrvService, srv)

  return srv, nil
}

// createServiceInstance creates a new Service instance with the provided options.
func createServiceInstance(opts ...providers.Option) (Service, error) {
  repo, err := ProvideRepository(opts...)
  if err != nil {
	return nil, err
  }

  return service.New(repo), nil
}
