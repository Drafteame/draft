func (ts *testSuite) TestSuccessGet() {
	t := ts.T()
	t.Parallel()

	repo := mocks.NewMockRepository(t)

	tw := newTestWrapper(t, withMocks(map[string]any{
		repository.PrvRepository: repo,
	}))

	data := domain.{{.DomainNamePascal}}{
		ID: "some-id",

		// TODO: [generated] Add fields

		CreatedAt: tw.clock.Now(),
		UpdatedAt: tw.clock.Now(),
	}

	repo.On("Get", mock.MatchedBy(tmock.AnyContextMatcher()), "some-id").
		Return(data, nil)

	got, err := tw.service.Get(context.TODO(), "some-id")
	if err != nil {
		t.Fatal(err)
	}

	assert.Equal(t, data.ID, got.ID)
	assert.IsType(t, domain.{{.DomainNamePascal}}{}, got)

	// TODO: [generated] add assertions
}

func (ts *testSuite) TestNotFoundRecord() {
	t := ts.T()
	t.Parallel()

	repo := mocks.NewMockRepository(t)

	tw := newTestWrapper(t, withMocks(map[string]any{
		repository.PrvRepository: repo,
	}))

	repo.On("Get", mock.MatchedBy(tmock.AnyContextMatcher()), "some-id").
		Return(daos.{{.DomainNamePascal}}{}, domain.ErrRecordNotFound)

	got, err := tw.service.Get(context.TODO(), "some-id")

	assert.ErrorIs(t, err, domain.ErrRecordNotFound)
	assert.Empty(t, got)
}

func (ts *testSuite) TestUnexpectedError() {
	t := ts.T()
	t.Parallel()

	tw := newTestWrapper(t)

	db := tw.mc.Get(prvpostgres.ProviderName(prvpostgres.Prv{{.DBProviderFuncName}})).(interface{ Close() error })
	if err := db.Close(); err != nil {
		t.Fatal(err)
	}

	got, err := tw.service.Get(context.TODO(), "some-id")

	assert.ErrorIs(t, err, domain.ErrUnexpected)
	assert.Empty(t, got)
}
