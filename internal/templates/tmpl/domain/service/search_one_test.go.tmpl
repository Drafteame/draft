package service

import (
	"context"

	"github.com/stretchr/testify/assert"

	"{{.PackageName}}/{{ .DomainPath }}/domain"
	"{{.PackageName}}/{{ .DomainPath }}/domain/options"
	"{{.PackageName}}/{{ .DomainPath }}/repository"
	"{{.PackageName}}/{{ .DomainPath }}/service/mocks"
)

func (ts *testSuite) TestSearchOneSuccess() {
	t := ts.T()
	t.Parallel()

	repo := mocks.NewMockRepository(t)

	w := newTestWrapper(t, withMocks(map[string]any{
		repository.PrvRepository: repo,
	}))

	filters := options.NewSearchFilters()

	repo.On("SearchOne", context.Background(), filters).
		Return(domain.{{.DomainNamePascal}}{ID: "some-id"}, nil)

	got, err := w.service.SearchOne(context.Background(), filters)
	if err != nil {
		t.Fatal(err)
	}

	assert.Equal(t, "some-id", got.ID)
}

func (ts *testSuite) TestSearchOneWhenRepositoryErrorShouldReturnTheSameError() {
	t := ts.T()
	t.Parallel()

	repo := mocks.NewMockRepository(t)

	w := newTestWrapper(t, withMocks(map[string]any{
		repository.PrvRepository: repo,
	}))

	filters := options.NewSearchFilters()

	repo.On("SearchOne", context.Background(), filters).
		Return(daos.{{.DomainNamePascal}}{}, assert.AnError)

	got, err := w.service.SearchOne(context.Background(), filters)
	if err == nil {
		t.Fatal("expected error")
	}

	assert.ErrorIs(t, err, assert.AnError)
	assert.Empty(t, got)
}
