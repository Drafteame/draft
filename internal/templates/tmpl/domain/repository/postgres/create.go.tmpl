package repository

import (
	"context"
	"errors"
	"strings"

	"{{.PackageName}}/{{ .DomainPath }}/domain"
)

func (r *Repository) Create(ctx context.Context, entity domain.{{.DomainNamePascal}}) (domain.{{.DomainNamePascal}}, error) {
	if entity.ID == "" {
		id, err := r.genID.Generate()
		if err != nil {
			return domain.{{.DomainNamePascal}}{}, errors.Join(domain.ErrUnexpected, err)
		}

		entity.ID = id
	}

	dao, err := domain.ToDAO(entity)
	if err != nil {
		return domain.{{.DomainNamePascal}}{}, errors.Join(domain.ErrUnexpected, err)
	}

	if err := r.driver.GetClient().WithContext(ctx).Create(&dao).Error; err != nil {
		if strings.Contains(err.Error(), "duplicate key") {
			return domain.{{.DomainNamePascal}}{}, errors.Join(domain.ErrDuplicatedRecord, err)
		}

		return domain.{{.DomainNamePascal}}{}, errors.Join(domain.ErrUnexpected, err)
	}

	return r.Get(ctx, entity.ID)
}
