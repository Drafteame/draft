package repository

import (
	"context"
	"sync"

	"{{.PackageName}}/{{ .DomainPath }}/repository/daos"
	"{{.PackageName}}/pkg/providers"
	prvdatetime "{{.PackageName}}/pkg/providers/datetime"
	prvpostgres "{{.PackageName}}/pkg/providers/postgres"
	generator "{{.PackageName}}/projects/framev2/pkg/drivers/generatorid/v2"
	"{{.PackageName}}/projects/framev2/pkg/stage"
	"{{.PackageName}}/projects/framev2/pkg/tracer"
)

const PrvRepository = "domains.{{ .DomainNameLower }}.repository"

var (
	instance any
	once     = &sync.Once{}
)

func Provide(ctx context.Context, opt ...providers.Option) (any, error) {
	newCtx, span := tracer.BeginSubSegment(ctx, "domains.{{ .DomainNameLower }}.repository.Provide")
	defer span.Close(nil)

	if stage.IsTest() {
		return provideTestRepository(ctx, opt...)
	}

	var err error

	once.Do(func() {
		i, errCreate := createInstance(newCtx, opt...)
		if errCreate != nil {
			err = errCreate
			return
		}

		instance = i
	})

	if err != nil {
		_ = span.AddError(err)
		return nil, err
	}

	return instance, nil
}

func provideTestRepository(ctx context.Context, opt ...providers.Option) (any, error) {
	options, err := providers.BuildOptions(opt...)
	if err != nil {
		return nil, err
	}

	if options.Container.Exists(PrvRepository) {
		return options.Container.Get(PrvRepository), nil
	}

	aux, err := createInstance(ctx, opt...)
	if err != nil {
		return nil, err
	}

	options.Container.Set(PrvRepository, aux)

	return aux, nil
}

func createInstance(ctx context.Context, opts ...providers.Option) (any, error) {
	newCtx, span := tracer.BeginSubSegment(ctx, "domains.{{ .DomainNameLower }}.repository.createInstance")
	defer span.Close(nil)

	postgres{{.DomainNamePascal}}, err := prvpostgres.Provide{{.DBProviderFuncName}}(opts...)
	if err != nil {
		_ = span.AddError(err)
		return nil, err
	}

	clock := providers.MustAs[Clock](newCtx, prvdatetime.ProvideClock, opts...)

	generatorID, err := generator.NewGeneratorID(daos.DBPrefix)
	if err != nil {
		_ = span.AddError(err)
		return nil, err
	}

	return New(postgres{{.DomainNamePascal}}, clock, generatorID), nil
}

