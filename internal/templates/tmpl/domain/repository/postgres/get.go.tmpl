package repository

import (
	"context"
	"errors"

	"gorm.io/gorm"

	"{{.PackageName}}/{{ .DomainPath }}/domain"
	"{{.PackageName}}/{{ .DomainPath }}/repository/daos"
	"{{.PackageName}}/projects/framev2/pkg/tracer"
)

func (r *Repository) Get(ctx context.Context, id string) (domain.{{.DomainNamePascal}}, error) {
	newCtx, span := tracer.BeginSubSegment(ctx, "domains.{{ .DomainNameLower }}.repository.Get")
	defer span.Close(nil)

	gormDB := r.driver.GetClient()

	dao := daos.{{.DomainNamePascal}}{}

	err := gormDB.WithContext(newCtx).
		Model(daos.{{.DomainNamePascal}}{}).
		Where("id = ? AND deleted_at IS NULL", id).
		First(&dao).
		Error

	if err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			dbErr := errors.Join(domain.ErrRecordNotFound, err)
			_ = span.AddError(dbErr)
			return domain.{{.DomainNamePascal}}{}, dbErr
		}

		dbErr := errors.Join(domain.ErrUnexpected, err)
		_ = span.AddError(dbErr)
		return domain.{{.DomainNamePascal}}{}, dbErr
	}

	return daos.ToDomain(dao), nil
}
