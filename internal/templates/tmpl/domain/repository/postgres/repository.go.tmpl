package repository

import (
	"{{.PackageName}}/projects/framev2/pkg/drivers/gorm"
)

type Repository struct {
	genID  GeneratorID
	clock  Clock
	driver gorm.Driver
}

func New(driver gorm.Driver, clock Clock, genID GeneratorID) *Repository {
	return &Repository{
		genID:  genID,
		clock:  clock,
		driver: driver,
	}
}
