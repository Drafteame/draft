package repository

import (
	"context"
	"errors"

	"{{.PackageName}}/{{ .DomainPath }}/domain"
	"{{.PackageName}}/{{ .DomainPath }}/repository/daos"
)

func (r *Repository) Delete(ctx context.Context, id string) (daos.{{.DomainNamePascal}}, error) {
	entity, err := r.Get(ctx, id)
	if err != nil {
		return daos.{{.DomainNamePascal}}{}, err
	}

	now := r.clock.Now()

	update := daos.Delete{{.DomainNamePascal}}{
		ID:        id,
		DeletedAt: &now,
	}

	if err := r.driver.GetClient().Model(&update).WithContext(ctx).Updates(update).Error; err != nil {
		return daos.{{.DomainNamePascal}}{}, errors.Join(domain.ErrDeleteRecord, err)
	}

	if err := r.driver.GetClient().Unscoped().Find(&entity).Error; err != nil {
		return daos.{{.DomainNamePascal}}{}, errors.Join(domain.ErrUnexpected, err)
	}

	return entity, nil
}
